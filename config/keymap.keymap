#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        left_Click {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
        };

        right_Click {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };

        middle_Click {
            bindings = <&mkp MCLK>;
            key-positions = <19 20 21>;
        };

        next_Click {
            bindings = <&mkp MB5>;
            key-positions = <33 34>;
        };

        prev_Click {
            bindings = <&mkp MB4>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB           &kp Q             &kp W     &kp E              &kp R  &kp T       &kp Y      &kp U            &kp I  &kp O           &kp P           &kp BSPC
&kp INT_MUHENKAN  &kp A             &kp S     &kp D              &kp F  &kp G       &kp H      &kp J            &kp K  &kp L           &kp MINUS       &kp ENTER
&kp LSHFT         &kp Z             &kp X     &kp C              &kp V  &kp B       &kp CAPS   &kp KP_NUMLOCK   &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &mt RSHFT SLASH
&kp LCTRL         &kp LEFT_COMMAND  &kp LALT  &kp LANG_HIRAGANA  &mo 3  &kp DELETE  &kp SPACE  &lt 5 BACKSPACE  &mo 2  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp N1    &kp N2            &kp N3    &kp N4      &kp N5     &kp N6     &kp N7            &kp N8     &kp N9                &kp N0                 &kp DELETE
&trans  &kp EXCL  &kp LEFT_BRACKET  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp LS(NUMBER_6)  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans    &trans            &trans    &trans      &trans     &trans     &trans            &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LS(COMMA)  &kp RS(PERIOD)  &kp SLASH
&trans  &trans    &trans            &trans    &trans      &trans     &trans     &trans            &trans     &trans                &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp KP_SLASH  &kp KP_ASTERISK      &kp KP_NUMBER_7   &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans        &kp KP_MINUS         &kp KP_NUMBER_4   &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans        &kp INTERNATIONAL_1  &kp SINGLE_QUOTE  &kp RS(KP_PLUS)  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans        &trans               &kp KP_NUMBER_0   &kp DOT          &kp EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
